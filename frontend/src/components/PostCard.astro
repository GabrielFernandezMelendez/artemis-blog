---
import type { Post } from '../lib/types';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const formattedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).toUpperCase();
---

<a
  href={`/posts/${post.slug}`}
  class="group relative flex flex-col overflow-hidden bg-surface w-full h-full"
>
  <!-- Imagen -->
  <div class="relative w-full h-full overflow-hidden">
    <img
      src={post.coverImage.src}
      alt={post.coverImage.alt}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />

    <!-- Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
  </div>

  <!-- Contenido -->
  <div class="absolute bottom-0 left-0 right-0 p-6 flex flex-col gap-2">
    <span class="text-text-secondary text-xs tracking-widest uppercase">
      {formattedDate}
    </span>

    <h2
      class={`text-text-primary font-bold leading-tight ${
        featured ? 'text-2xl' : 'text-base'
      }`}
    >
      {post.title}
    </h2>

    {featured && (
      <>
        <p class="text-text-secondary text-sm line-clamp-2 mt-1">
          {post.excerpt}
        </p>

        <span class="text-accent text-sm mt-2">
          Read story →
        </span>
      </>
    )}
  </div>
</a>