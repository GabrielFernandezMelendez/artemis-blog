---
import type { Post } from '../lib/types';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const formattedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).toUpperCase();
---

<a href={`/posts/${post.slug}`} class="card-link">
  <img
    src={post.coverImage.src}
    alt={post.coverImage.alt}
    class="card-img"
  />
  <div class="card-overlay"></div>
  <div class="card-content">
    <span class="card-date">{formattedDate}</span>
    <h2 class={`card-title ${featured ? 'card-title--featured' : ''}`}>
      {post.title}
    </h2>
    {featured && (
      <p class="card-excerpt">{post.excerpt}</p>
    )}
    {featured && (
      <span class="card-cta">Read story →</span>
    )}
  </div>
</a>

<style>
  .card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #111111;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-link:hover .card-img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.2), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-link:hover .card-overlay {
    opacity: 1;
  }

  .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transform: translateY(1rem);
    opacity: 0;
    transition: all 0.3s ease;
  }

  .card-link:hover .card-content {
    transform: translateY(0);
    opacity: 1;
  }

  .card-date {
    color: #A0A0A0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-title {
    color: #F1F1F1;
    font-weight: 700;
    line-height: 1.2;
    font-size: 1rem;
  }

  .card-title--featured {
    font-size: 1.5rem;
  }

  .card-excerpt {
    color: #A0A0A0;
    font-size: 0.875rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.25rem;
  }

  .card-cta {
    color: #2563EB;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
</style>