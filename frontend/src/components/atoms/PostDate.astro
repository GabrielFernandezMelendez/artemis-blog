---
import { formatDate } from "../../lib/formatDate";

interface Props {
  date: string;
  format?: "short" | "long";
}

const { date, format = "short" } = Astro.props;

const formatted = formatDate(date, format);
---

<time datetime={date} class="text-text-secondary font-semibold text-label tracking-widest uppercase">
  {formatted}
</time>