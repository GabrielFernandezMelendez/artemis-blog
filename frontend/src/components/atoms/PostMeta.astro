---
import PostDate from "./PostDate.astro";

interface Props {
  date: string;
  readingTime: number;
}

const { date, readingTime } = Astro.props;
---

<div class="flex flex-col gap-1 text-text-secondary text-label font-semibold tracking-widest uppercase sm:flex-row sm:items-center sm:gap-2">
  <PostDate date={date} format="long" />
  <span class="hidden sm:inline" aria-hidden="true">·</span>
  <span>{readingTime} min read</span>
</div>