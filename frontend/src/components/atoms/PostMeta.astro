---
import PostDate from "./PostDate/PostDate.astro";
import Text from "./Text.astro";

interface Props {
  date: string;
  readingTime: number;
}

const { date, readingTime } = Astro.props;
---

<div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
  <!-- Fecha del post en formato largo -->
  <PostDate date={date} format="long" />
  <!-- Separador visible solo en desktop -->
  <Text as="span" variant="label" class="hidden sm:inline" aria-hidden="true">·</Text>
  <!-- Tiempo de lectura estimado -->
  <Text as="span" variant="label" aria-label={`${readingTime} minutos de lectura`} class="text-text-secondary uppercase">{readingTime} min read</Text>
</div>
