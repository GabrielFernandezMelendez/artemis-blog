---
interface Props {
  as: "h1" | "h2" | "h3" | "p" | "span" | "time";
  variant:
    | "display"
    | "h1"
    | "h2"
    | "h3"
    | "body-lg"
    | "body"
    | "caption"
    | "label";
  class?: string;
}

const { as, variant, class: className = "" } = Astro.props;

const variantStyles: Record<string, string> = {
  display: "text-display font-bold leading-tight text-text-primary",
  h1: "text-h1 font-bold leading-tight text-text-primary",
  h2: "text-h2 font-bold leading-tight text-text-primary",
  h3: "text-h3 font-bold leading-tight text-text-primary",
  "body-lg": "text-body-lg font-regular leading-relaxed text-text-primary",
  body: "text-body font-regular leading-relaxed text-text-primary",
  caption: "text-caption font-bold ",
  label: "text-label font-semibold tracking-widest ",
};

const styles = variantStyles[variant];
---

{
  as === "h1" && (
    <h1 class={`${styles} ${className}`}>
      <slot />
    </h1>
  )
}
{
  as === "h2" && (
    <h2 class={`${styles} ${className}`}>
      <slot />
    </h2>
  )
}
{
  as === "h3" && (
    <h3 class={`${styles} ${className}`}>
      <slot />
    </h3>
  )
}
{
  as === "p" && (
    <p class={`${styles} ${className}`}>
      <slot />
    </p>
  )
}
{
  as === "span" && (
    <span class={`${styles} ${className}`}>
      <slot />
    </span>
  )
}
{
  as === "time" && (
    <time class={`${styles} ${className}`}>
      <slot />
    </time>
  )
}
