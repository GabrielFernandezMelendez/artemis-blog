---
import { resolveTextStyles } from "./textStyles";
interface Props {
  as: "h1" | "h2" | "h3" | "p" | "span" | "time";
  variant: "display" | "h1" | "h2" | "h3" | "body-lg" | "body" | "caption" | "label";
  class?: string;
}

const { as, variant, class: className = "" } = Astro.props;
const styles = resolveTextStyles(variant, className);
---

{
  as === "h1" && (
    <h1 class={styles}>
      <slot />
    </h1>
  )
}
{
  as === "h2" && (
    <h2 class={styles}>
      <slot />
    </h2>
  )
}
{
  as === "h3" && (
    <h3 class={styles}>
      <slot />
    </h3>
  )
}
{
  as === "p" && (
    <p class={styles}>
      <slot />
    </p>
  )
}
{
  as === "span" && (
    <span class={styles}>
      <slot />
    </span>
  )
}
{
  as === "time" && (
    <time class={styles}>
      <slot />
    </time>
  )
}
