---
import type { Post } from "../../lib/types";
import PostDate from "../atoms/PostDate.astro";
import ReadMoreLink from "../atoms/ReadMoreLink.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a href={`/posts/${post.slug}`} aria-label={`Leer artículo: ${post.title}`} class="group relative block overflow-hidden bg-surface w-full h-full no-underline focus:ring-2 focus:ring-accent">

  <span class="absolute bottom-0 left-0 right-0 p-4 bg-black/90 text-text-primary text-base font-bold text-center z-10 opacity-0 translate-y-full transition-all duration-200 group-focus:opacity-100 group-focus:translate-y-0 group-hover:opacity-0 group-hover:translate-y-full">
    {post.title}
  </span>

  <img src={post.coverImage.src} alt={post.coverImage.alt} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />

  <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity duration-300"></div>

  <div class="absolute bottom-0 left-0 right-0 p-6 flex flex-col gap-2 translate-y-0 opacity-100 sm:translate-y-4 sm:opacity-0 sm:group-hover:translate-y-0 sm:group-hover:opacity-100 transition-all duration-300 group-focus:opacity-0 group-focus:group-hover:opacity-100">
    <PostDate date={post.publishedAt} />
    <h2 class="text-text-primary font-bold leading-tight text-base">{post.title}</h2>
    <p class="text-text-secondary text-sm mt-1 line-clamp-1">{post.excerpt}</p>
    <ReadMoreLink />
  </div>
</a>