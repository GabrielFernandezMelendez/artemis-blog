---
import { FOOTER } from "../../constants";
---

<footer class="px-5 sm:px-64 py-64 bg-surface flex items-center">
  <div class="flex flex-col gap-5">
    <span class="text-text-primary text-caption font-bold">
      {FOOTER.toprow}
    </span>
    <span class="text-text-secondary text-label font-semibold uppercase sm:hidden">
      {FOOTER.mobileCopyright}
    </span>
    <span class="hidden text-text-secondary text-label font-semibold uppercase sm:inline">
      {FOOTER.copyright}
    </span>
  </div>
</footer>
