---
import { FOOTER } from "../../constants";
import Text from "../atoms/Text.astro";
---

<footer class="px-5 sm:px-64 py-64 bg-surface flex items-center">
  <div class="flex flex-col gap-5">
    <!-- Nombre del blog -->
    <Text as="span" variant="caption" class="text-text-primary font-bold">
      {FOOTER.toprow}
    </Text>

    <!-- Copyright version mobile -->
    <Text as="span" variant="label" class="sm:hidden">
      {FOOTER.mobileCopyright}
    </Text>

    <!-- Copyright version desktop -->
    <Text as="span" variant="label" class="hidden sm:inline">
      {FOOTER.copyright}
    </Text>
  </div>
</footer>