---
import SectionLabel from "../atoms/SectionLabel.astro";
import Text from "../atoms/Text.astro";

interface Props {
  preheader: string;
  title: string;
  description: string;
}

const { preheader, title, description } = Astro.props;
---

<section class="px-5 sm:px-64 py-64 flex flex-col gap-2">
  <SectionLabel text={preheader} />
  <Text as="h1" variant="hero-title">
    {title}
  </Text>
  <Text as="p" variant="hero-description">
    {description}
  </Text>
</section>
