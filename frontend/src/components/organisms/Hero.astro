---
import SectionLabel from "../atoms/SectionLabel.astro";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="p-8 sm:p-16 pt-2 pb-6 flex flex-col gap-2">
  <SectionLabel text={eyebrow} />
  <h1 class="text-text-primary text-4xl sm:text-8xl font-bold leading-tight">
    {title}
  </h1>
  <p class="text-text-primary font-base sm:font-bold text-sm sm:text-2xl">
    {description}
  </p>
</section>