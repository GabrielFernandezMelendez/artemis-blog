---
import SectionLabel from "../atoms/SectionLabel/SectionLabel.astro";
import Text from "../atoms/Text/Text.astro";

interface Props {
  preheader: string;
  title: string;
  description: string;
}

const { preheader, title, description } = Astro.props;
---

<section aria-labelledby="hero-title" class="px-5 sm:px-64 py-64 flex flex-col gap-2">
  <SectionLabel text={preheader} />
  <Text as="h1" variant="h1" id="hero-title" class="max-w-[320px] sm:max-w-none sm:text-display">
    {title}
  </Text>
  <Text as="p" variant="caption" class="sm:text-h3 sm:font-bold text-text-primary">
    {description}
  </Text>
</section>
