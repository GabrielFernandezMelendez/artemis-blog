---
import type { Post } from "../../lib/types";
import PostCard from "../molecules/PostCard.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
//ya no esta feature y aqui separamos los post para que el primero sea el destacado 
const [featuredPost, ...remainingPosts] = posts;
---

<section class="grid  grid-cols-1 md:grid-cols-3 [auto-rows:60vw] md:[auto-rows:calc(100vw/3)]">

  <div class="md:col-span-2 md:row-span-2 h-full min-h-0">
    <PostCard post={featuredPost} />
  </div>

  {remainingPosts.map((post) => (
    <div class="h-full min-h-0">
      <PostCard post={post} />
    </div>
  ))}

</section>