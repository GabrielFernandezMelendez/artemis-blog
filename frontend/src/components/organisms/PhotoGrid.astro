---
import type { Post } from "../../lib/types";
import PostCard from "../molecules/PostCard.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="grid w-full grid-cols-1 md:grid-cols-3 gap-1 overflow-hidden [auto-rows:60vw] md:[auto-rows:calc(100vw/3)]">

  <div class="md:col-span-2 md:row-span-2 h-full min-h-0">
    <PostCard post={posts[0]} featured={true} />
  </div>

  {posts.slice(1).map((post) => (
    <div class="h-full min-h-0">
      <PostCard post={post} />
    </div>
  ))}

</section>