---
import type { Post } from "../../lib/types";
import PostCard from "../molecules/PostCard/PostCard.astro";
import SectionLabel from "../atoms/SectionLabel.astro";
import Text from "../atoms/Text/Text.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section aria-labelledby="related-title" class="p-6 py-16 border-t border-text-primary">
  <div class="flex pt-24 pb-12 flex-col gap-1 mb-8">
    <!-- Etiqueta de sección -->
    <SectionLabel text="Continue Reading" />
    <!-- Título de la sección -->
    <Text as="h2" variant="h2" id="related-title" class="text-h3 sm:text-h2"> Related stories </Text>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3">
    {
      posts.map((post) => (
        <div>
          <PostCard post={post} variant="detail" />
        </div>
      ))
    }
  </div>
</section>
