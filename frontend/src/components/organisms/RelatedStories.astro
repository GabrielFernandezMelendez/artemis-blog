---
import type { Post } from "../../lib/types";
import PostCard from "../molecules/PostCard.astro";
import { getPostsByTag } from "../../lib/api";

interface Props {
  currentPost: Post;
}

const { currentPost } = Astro.props;

const firstTag = currentPost.tags.split(",")[0].trim();
const tagPosts = await getPostsByTag(firstTag);

const related = tagPosts
  .filter((post) => post.slug !== currentPost.slug)
  .slice(0, 3);
---

<section class="px-6 py-16 border-t border-elevated">
  <div class="flex flex-col gap-1 mb-8">
    <span class="text-warm text-xs tracking-widest uppercase">
      Continue Reading
    </span>
    <h2 class="text-text-primary text-2xl sm:text-4xl font-bold">
      Related stories
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3">
    {
      related.map((post) => (
        <div class="h-64">
          <PostCard post={post} />
        </div>
      ))
    }
  </div>
</section>
