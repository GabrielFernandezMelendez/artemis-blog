---
import type { Post } from "../../lib/types";
import PostCard from "../molecules/PostCard.astro";
import SectionLabel from "../atoms/SectionLabel.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="px-6 py-16 border-t border-elevated">
  <div class="flex flex-col gap-1 mb-8">
    <SectionLabel text="Continue Reading" />
    <h2 class="text-text-primary text-2xl sm:text-4xl font-bold">
      Related stories
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3">
    {
      posts.map((post) => (
        <div class="h-80">
          <PostCard post={post} />
        </div>
      ))
    }
  </div>
</section>
