---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { getPosts } from "../lib/api";

const posts = await getPosts();
---

<BaseLayout>
  <Header />

  <main class="flex-1">
    <!-- Hero text -->
    <section class="px-8 pt-2 pb-6 flex flex-col gap-2">
      <span class="text-text-secondary text-xs tracking-widest uppercase">
        NASA · Artemis II Mission
      </span>
      <h1 class="text-text-primary text-5xl font-bold leading-tight">
        The artemis diary
      </h1>
      <p class="text-text-secondary text-base max-w-md">
        Stories, images and field notes from NASA's Artemis II mission.
      </p>
    </section>

    <!-- Grid de posts -->
    <PhotoGrid posts={posts} />
  </main>

  <Footer />
</BaseLayout>
