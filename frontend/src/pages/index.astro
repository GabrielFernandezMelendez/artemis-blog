---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/organisms/Header/Header.astro";
import Footer from "../components/organisms/Footer/Footer.astro";
import PhotoGrid from "../components/organisms/PhotoGrid/PhotoGrid.astro";
import Hero from "../components/organisms/Hero/Hero.astro";
import { HERO } from "../ui-strings";
import { GetPosts } from "../post/application/GetPosts";
import { HttpPostRepository } from "../post/infrastructure/HttpPostRepository";

const repository = new HttpPostRepository();
const getPosts = new GetPosts(repository);
const posts = await getPosts.execute();
---

<BaseLayout>
  <Header />

  <main class="flex-1">
    <Hero preheader={HERO.preheader} title={HERO.title} description={HERO.description} />

    <PhotoGrid posts={posts} />
  </main>

  <Footer />
</BaseLayout>
