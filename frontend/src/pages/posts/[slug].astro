---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedStories from '../../components/RelatedStories.astro';
import { getPostBySlug, getPosts } from '../../lib/api';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/404');
}

const allPosts = await getPosts();

const formattedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).toUpperCase();
---

<BaseLayout title={post.title} description={post.excerpt} image={post.coverImage.src}>

  <Header />

  <main class="flex-1">

    <!-- Hero image -->
    <div class="relative w-full h-[60vh] overflow-hidden">
      <img
        src={post.coverImage.src}
        alt={post.coverImage.alt}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
    </div>

    <!-- Artículo -->
    <article class="max-w-2xl mx-auto px-6 py-12 flex flex-col gap-6">

      <!-- Back -->
      <a href="/"
        class="text-text-secondary text-xs tracking-widest uppercase hover:text-text-primary transition-colors">
        ← Back to stories
      </a>

      <!-- Título -->
      <h1 class="text-text-primary text-4xl font-bold leading-tight">
        {post.title}
      </h1>

      <!-- Meta -->
      <div class="flex items-center gap-4 text-text-secondary text-xs tracking-widest uppercase">
        <span>{formattedDate}</span>
        <span>·</span>
        <span>{post.readingTime} min read</span>
      </div>

      <!-- Excerpt -->
      <p class="text-text-secondary text-lg leading-relaxed border-l-2 border-accent pl-4">
        {post.excerpt}
      </p>

      <!-- Contenido HTML -->
      <div class="prose prose-invert prose-lg max-w-none
                  prose-headings:text-text-primary prose-headings:font-bold
                  prose-p:text-text-secondary prose-p:leading-relaxed
                  prose-a:text-accent">
        <Fragment set:html={post.content} />
      </div>

    </article>

    <!-- Related stories -->
    <RelatedStories currentSlug={post.slug} posts={allPosts} />

  </main>

  <Footer />

</BaseLayout>