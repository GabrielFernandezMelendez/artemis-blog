---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/organisms/Header.astro";
import Footer from "../../components/organisms/Footer.astro";
import RelatedStories from "../../components/organisms/RelatedStories.astro";
import PostMeta from "../../components/atoms/PostMeta.astro";
import Text from "../../components/atoms/Text.astro";
import { getPostBySlug, getPosts, getPostsByTag } from "../../lib/api";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect("/404");
}

const firstTag = post.tags.split(",")[0].trim();
const tagPosts = await getPostsByTag(firstTag);
const relatedPosts = tagPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  image={post.coverImage.src}
>
  <Header />

  <!-- Navegación de vuelta al listado (incluida la aria-label para temas de accesibilidad)-->
  <nav aria-label="Volver al listado" class="container max-w-4xl mx-auto px-6 py-24 flex gap-6">
    <a
      href="/"
      class="text-text-secondary font-semibold sm:font-regular text-label tracking-widest hover:text-text-primary uppercase sm:normal-case"
    >
      ← Back to stories
    </a>
  </nav>

  <main class="flex-1">
    <!-- Imagen de cabecera del post -->
    <div class="relative h-[60vh] overflow-hidden">
      <img
        src={post.coverImage.src}
        alt={post.coverImage.alt}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent">
      </div>
    </div>

    <article class="max-w-4xl mx-auto px-6 py-12 flex flex-col gap-6">
      <!-- Título principal del post -->
      <Text as="h1" variant="h1" class="text-h2 sm:text-h1">
        {post.title}
      </Text>

      <!-- Fecha y tiempo de lectura -->
      <PostMeta date={post.publishedAt} readingTime={post.readingTime} />

      <!-- Extracto del post -->
      <Text as="p" variant="body-lg" class="sm:text-h3 sm:font-bold">
        {post.excerpt}
      </Text>

      <!-- Contenido del post -->
      <div
        class="prose prose-invert prose-lg max-w-none prose-headings:text-text-primary prose-headings:font-bold prose-p:text-text-primary prose-p:leading-relaxed prose-a:text-accent"
      >
        <Fragment set:html={post.content} />
      </div>
    </article>

    <RelatedStories posts={relatedPosts} />
  </main>

  <Footer />
</BaseLayout>
