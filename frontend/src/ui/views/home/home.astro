---
import { getAllPosts } from '@/core/api'
import Hero from '@/ui/organisms/hero/hero.astro'
import PostCard from '@/ui/molecules/postCard/postCard.astro'

const posts = await getAllPosts()
---

<Hero />

<ul class="container grid grid-cols-1 lg:grid-cols-3 lg:grid-rows-2">
  {
    posts.map((post) => (
      <li class="lg:first:col-span-2 lg:first:row-span-2">
        <PostCard post={post} />
      </li>
    ))
  }
</ul>
