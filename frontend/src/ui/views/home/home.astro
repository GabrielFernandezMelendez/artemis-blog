---
import { getAllPosts } from '@/core/api'

const posts = await getAllPosts()
---

<h1 class="text-display">The Artemis Diary</h1>

<ul>
  {
    posts.map((post) => (
      <li>
        <article>
          <h2 class="text-heading-3">{post.title}</h2>
        </article>
      </li>
    ))
  }
</ul>
