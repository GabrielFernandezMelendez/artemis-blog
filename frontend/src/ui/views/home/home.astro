---
import { getAllPosts } from '@/core/api'
import Hero from '@/ui/organisms/hero/hero.astro'

const posts = await getAllPosts()
---

<Hero />

<ul>
  {
    posts.map((post) => (
      <li>
        <article>
          <h2 class="text-heading-3">{post.title}</h2>
        </article>
      </li>
    ))
  }
</ul>
