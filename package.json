{
  "name": "artemis-blog",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:front": "pnpm --dir frontend dev",
    "dev:api": "pnpm --dir backend dev",
    "build": "pnpm -r --parallel build",
    "build:front": "pnpm --dir frontend build",
    "build:api": "pnpm --dir backend build",
    "start": "pnpm -r --parallel start",
    "start:api": "pnpm --dir backend start",
    "preview": "pnpm -r --parallel build && pnpm -r --parallel preview",
    "preview:front": "pnpm --dir frontend preview",
    "preview:api": "pnpm --dir backend start",
    "test:front": "pnpm --dir frontend test"
  }
}
